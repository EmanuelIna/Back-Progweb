# Set these in the process environment; Spring does not automatically load .env files.
SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<database-password>
JWT_SECRET=<independent-random-secret-at-least-32-bytes>
CART_SECRET=<independent-random-secret-at-least-32-bytes>
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
